<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

  <display-name>IMS Fuel Master Pro v2</display-name>

  <!-- Database -->
  <context-param>
    <param-name>DB_URL</param-name>
    <param-value>jdbc:oracle:thin:@10.35.29.123:1521:eic</param-value>
  </context-param>
  <context-param>
    <param-name>DB_USER</param-name>
    <param-value>ims_fuel</param-value>
  </context-param>
  <context-param>
    <param-name>DB_PASS</param-name>
    <param-value>ims_fuel123</param-value>
  </context-param>

  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>

  <!-- Servlets -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>FuelEntryServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.FuelEntryServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>MasterServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.MasterServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>TankRefillServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.TankRefillServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>UnitMasterServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.UnitMasterServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>ReportServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.ReportServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>com.barc.ims.servlet.DashboardServlet</servlet-class>
  </servlet>

  <!-- Mappings -->
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/LoginServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>FuelEntryServlet</servlet-name>
    <url-pattern>/FuelEntryServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>MasterServlet</servlet-name>
    <url-pattern>/MasterServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>TankRefillServlet</servlet-name>
    <url-pattern>/TankRefillServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>UnitMasterServlet</servlet-name>
    <url-pattern>/UnitMasterServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReportServlet</servlet-name>
    <url-pattern>/ReportServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/DashboardServlet</url-pattern>
  </servlet-mapping>

  <!-- Auth Filter -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.barc.ims.util.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/pages/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/FuelEntryServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/MasterServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/TankRefillServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/DashboardServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/ReportServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/UnitMasterServlet</url-pattern>
  </filter-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <error-page>
    <error-code>404</error-code>
    <location>/pages/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/pages/error.jsp</location>
  </error-page>

</web-app>
